{
  "id": "/atelier-signature/pc/musique/",
  "name": "Mélodie",
  "short_name": "Mélodie",
  "description": "Écouter la musique du PC (dossier gardé à sa place), listes, pochettes",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121016",
  "theme_color": "#121016",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/ogg": [
          ".ogg",
          ".opus"
        ]
      }
    }
  ]
}
