{
  "id": "/atelier-signature/pc/texte/",
  "name": "Texte",
  "short_name": "Texte",
  "description": "Traitement de texte : pagination, styles, tableaux, suivi des modifications, publipostage, .docx, .odt et PDF",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#f6f7f9",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-magdoc": [
          ".magdoc"
        ]
      }
    },
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ]
      }
    },
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ]
      }
    },
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/rtf": [
          ".rtf"
        ]
      }
    },
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/plain": [
          ".txt"
        ]
      }
    },
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/markdown": [
          ".md"
        ]
      }
    }
  ]
}
